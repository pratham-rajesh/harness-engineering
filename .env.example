# --- Option 1 (default): OpenRouter free models. Free account, no card needed.
# Create a key at https://openrouter.ai/keys  -- models ending in ":free" cost $0.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=openrouter/free
# Optional: comma-separated models to rotate through when one is rate-limited.
# LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free

# --- Option 2: fully local with Ollama (https://ollama.com, free, no account).
#   ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
